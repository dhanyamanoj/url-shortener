# Copy to .env for local overrides. Never commit real secrets.

# --- Shared Postgres (Supabase free: prefer pooler / transaction mode URI) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/urlshortener
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Cloud example (do not put real values here):
# DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# --- Redis (Upstash free) ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=600
# Cloud example:
# REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

# --- RabbitMQ (CloudAMQP Little Lemur free: 1 connection per service) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PREFETCH=10
CLICK_QUEUE=click.events
# Cloud example:
# SPRING_RABBITMQ_ADDRESSES=amqps://USER:PASS@HOST/VHOST

# --- App / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
SHORT_URL_BASE=http://localhost:8080
ANALYTICS_RECENT_LIMIT=20

# --- Service ports (Railway sets PORT; map via SERVER_PORT) ---
# shortener-service
# SERVER_PORT=8080
# analytics-service
# SERVER_PORT=8081
